---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) =>
  b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<Layout
  title="Blog - The Green Dots | Microsoft 365 Presence Tracking Insights"
  description="Learn about Microsoft Teams presence tracking, remote team management, and work-life balance monitoring. Expert guides and best practices."
>
  <Header />

  <section class="blog-hero">
    <div class="container">
      <h1 class="blog-hero-title">The Green Dots Blog</h1>
      <p class="blog-hero-subtitle">
        Insights on Microsoft 365 presence tracking, remote team management, and productivity analytics
      </p>
    </div>
  </section>

  <section class="blog-listing">
    <div class="container">
      <div class="blog-grid">
        {sortedPosts.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.id}`} class="blog-card-link">
              <div class="blog-card-content">
                {post.data.featured && (
                  <span class="blog-badge">Featured</span>
                )}
                <h2 class="blog-title">{post.data.title}</h2>
                <p class="blog-excerpt">{post.data.description}</p>
                <div class="blog-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  <span class="blog-category">{post.data.category}</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .blog-hero {
    padding: 8rem 0 4rem;
    background: linear-gradient(135deg, oklch(0.97 0.004 260) 0%, oklch(0.99 0.002 260) 100%);
    border-bottom: 1px solid oklch(0.94 0.006 260);
  }

  .blog-hero-title {
    font-size: 3rem;
    font-weight: 800;
    color: oklch(0.20 0.010 260);
    margin-bottom: 1rem;
    text-align: center;
  }

  .blog-hero-subtitle {
    font-size: 1.25rem;
    color: oklch(0.65 0.010 260);
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .blog-listing {
    padding: 4rem 0;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .blog-card {
    background: white;
    border-radius: 12px;
    border: 1px solid oklch(0.94 0.006 260);
    transition: all 0.2s ease;
    height: 100%;
  }

  .blog-card:hover {
    border-color: oklch(0.62 0.15 155);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
  }

  .blog-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .blog-card-content {
    padding: 2rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .blog-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: oklch(0.62 0.15 155);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 4px;
    margin-bottom: 1rem;
    width: fit-content;
  }

  .blog-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: oklch(0.20 0.010 260);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .blog-excerpt {
    font-size: 1rem;
    color: oklch(0.65 0.010 260);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .blog-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid oklch(0.94 0.006 260);
    font-size: 0.875rem;
    color: oklch(0.65 0.010 260);
  }

  .blog-category {
    font-weight: 600;
    color: oklch(0.62 0.15 155);
  }

  @media (max-width: 768px) {
    .blog-hero {
      padding: 6rem 0 3rem;
    }

    .blog-hero-title {
      font-size: 2rem;
    }

    .blog-hero-subtitle {
      font-size: 1rem;
    }

    .blog-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
