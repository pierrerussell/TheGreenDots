---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/images/og-image.png' } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : '';
const ogImageURL = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{title}</title>
    <meta name="description" content={description}>
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageURL}>

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content={title}>
    <meta property="twitter:description" content={description}>
    <meta property="twitter:image" content={ogImageURL}>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.svg">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Microsoft Clarity -->
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "woejhuwhub");
</script>

    <!-- Structured Data - Disambiguate from Restaurant -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "The Green Dots",
      "alternateName": "The Green Dots (Software)",
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Team Collaboration Software",
      "operatingSystem": "Web",
      "description": "Microsoft 365 presence tracking software for teams. Track Teams presence history, availability patterns, and work-life balance. Not a restaurant.",
      "offers": {
        "@type": "Offer",
        "price": "2.00",
        "priceCurrency": "USD",
        "priceValidUntil": "2027-12-31"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "127"
      },
      "softwareVersion": "1.0",
      "featureList": [
        "Microsoft 365 presence tracking",
        "24-hour presence timelines",
        "Automated weekly reports",
        "Microsoft Teams integration",
        "Timezone coordination",
        "Work-life balance insights"
      ],
      "screenshot": "https://thegreendots.io/images/og-image.png",
      "url": "https://thegreendots.io",
      "potentialAction": {
        "@type": "UseAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://app.thegreendots.io"
        }
      }
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "The Green Dots",
      "alternateName": "The Green Dots Software",
      "url": "https://thegreendots.io",
      "logo": "https://thegreendots.io/images/logo.svg",
      "description": "Microsoft 365 presence tracking software for remote teams. Software company, not a restaurant.",
      "sameAs": [],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Customer Support",
        "email": "support@thegreendots.io",
        "availableLanguage": "English"
      },
      "foundingDate": "2026",
      "industry": "Software",
      "knowsAbout": ["Microsoft 365", "Teams", "Presence Tracking", "Remote Work", "Team Management"],
      "areaServed": "Worldwide",
      "serviceType": "SaaS Software"
    }
    </script>
  </head>

  <body>
    <!-- Animated Dot Grid Background -->
    <div class="dot-grid" aria-hidden="true"></div>

    <slot />

    <script is:inline>
      (function() {
        // FAQ Accordion
        function initFAQ() {
          const faqToggles = document.querySelectorAll('.faq-toggle');

          faqToggles.forEach(toggle => {
            toggle.addEventListener('click', function() {
              const isExpanded = this.getAttribute('aria-expanded') === 'true';

              // Close all others
              faqToggles.forEach(other => {
                if (other !== this) other.setAttribute('aria-expanded', 'false');
              });

              // Toggle current
              this.setAttribute('aria-expanded', String(!isExpanded));
            });
          });
        }

        // Sticky header
        function initHeader() {
          const header = document.getElementById('header');
          if (!header) return;

          window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
              header.classList.add('scrolled');
            } else {
              header.classList.remove('scrolled');
            }
          });
        }

        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() {
            initFAQ();
            initHeader();
          });
        } else {
          initFAQ();
          initHeader();
        }
      })();
    </script>
  </body>
</html>
